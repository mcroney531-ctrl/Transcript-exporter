{
  "manifest_version": 3,
  "name": "Claude Conversation Exporter",
  "version": "1.1.0",
  "description": "Export the current Claude.ai conversation to a plain text or Markdown file for handoff to a new chat.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["https://claude.ai/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export Claude Conversation"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
